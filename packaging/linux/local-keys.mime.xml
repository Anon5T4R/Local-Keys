<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info for Local Keys' own vault format (.tkeys). Installed to
     /usr/share/mime/packages/ (update-mime-database runs on install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-localkeys">
    <comment>Local Keys vault</comment>
    <icon name="local-keys"/>
    <glob pattern="*.tkeys"/>
  </mime-type>
</mime-info>
