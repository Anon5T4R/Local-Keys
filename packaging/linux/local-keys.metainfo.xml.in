<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh substitutes @VERSION@
     and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <!-- rDNS no AppStream (exigência do appstreamcli); a identidade do app — WM class, .desktop,
       ícone, nomes de asset do updater — continua flat "local-keys" (launchable abaixo). -->
  <id>com.local.localkeys</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>LocalKeys</name>
  <summary>Store passwords, TOTP codes and notes offline</summary>
  <developer id="com.local.localkeys">
    <name>LocalKeys contributors</name>
  </developer>
  <description>
    <p>
      LocalKeys is an open-source password manager written in pure Rust: an encrypted .tkeys
      vault protected by Argon2id, logins with TOTP, attachments, folders, trash and password
      history, plus a generator and importers for other managers. No account, no telemetry,
      no third-party servers. 100% local and offline.
    </p>
  </description>
  <launchable type="desktop-id">local-keys.desktop</launchable>
  <icon type="stock">local-keys</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/Anon5T4R/Local-Keys</url>
  <url type="bugtracker">https://github.com/Anon5T4R/Local-Keys/issues</url>
  <url type="help">https://github.com/Anon5T4R/Local-Keys</url>
  <url type="contact">https://github.com/Anon5T4R/Local-Keys/issues</url>
  <categories>
    <category>Utility</category>
    <category>Security</category>
  </categories>
  <keywords>
    <keyword>password</keyword>
    <keyword>passwords</keyword>
    <keyword>manager</keyword>
    <keyword>vault</keyword>
    <keyword>totp</keyword>
  </keywords>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <!-- The vault .tkeys is a private format, so no file mediatype is claimed: only the binary. -->
  <provides>
    <binary>local-keys</binary>
  </provides>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
