<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Desbloqueio rápido: o BiometricPrompt exige esta permissão (API 28+). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Notificação de feedback do autofill (cofre trancado). O app não a pede ao abrir: sem ela, o aviso sai
         como toast (LocalKeysAutofillService.notify). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Atualizador opcional (desligado por padrão): a única rede do app é ler as releases do Local Keys no GitHub
         e baixar o APK, e só com a verificação automática ligada ou no "verificar agora". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Entregar o APK baixado ao instalador do sistema (o usuário ainda libera "instalar apps desconhecidos"). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Ver se o Google Play services existe: só a importação de outro gerenciador depende dele (PlayServices). -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalKeys.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LocalKeys.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Autofill nativo (API do SO, sem Play Services). Aparece em
             Configurações > Senhas e contas > Autofill depois de ativado. -->
        <service
            android:name=".autofill.LocalKeysAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!-- Escolher no autofill um login com TOTP: monta o código na hora (e o copia, se ligado). Invisível;
             só o PendingIntent do próprio serviço a abre. -->
        <activity
            android:name=".autofill.AutofillTotpActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Provedor do Credential Manager (Android 14+): senhas e passkeys. Ativado em
             Configurações > Senhas, passkeys e contas. -->
        <service
            android:name=".credentials.LocalKeysCredentialService"
            android:enabled="@bool/credential_provider_enabled"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <!-- Tela do provedor: destrancar, entregar ou criar uma credencial. Só o sistema a abre
             (pelo PendingIntent da entrada escolhida). -->
        <activity
            android:name=".credentials.CredentialActivity"
            android:enabled="@bool/credential_provider_enabled"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LocalKeys.Base" />

        <!-- Resultado da instalação da atualização (PackageInstaller). Só o PendingIntent do próprio app chega aqui. -->
        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Idioma por app antes do Android 13: o AppCompat guarda a escolha sozinho (autoStoreLocales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
